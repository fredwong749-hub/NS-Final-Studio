*.wav filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# 文本统一 LF（多会话在 Windows 写文件会转成 CRLF，2026-10-30 总调度 fredw-b3 加）
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# K-OPS-F10（FACTORY 11-02）：服务器上执行的脚本 / systemd 单元一律 LF（CRLF 会让 bash 报 set: -: invalid option）
*.sh text eol=lf
*.service text eol=lf
*.env text eol=lf
# 总调度 11-02 20:1x：Python 源码固定 LF——服务器部署的就是版本库原字节，两边 sha 直接可比
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
