+def _health(url: str) -> dict | None:
+    """本机服务 /health → dict（loaded / queue …）；没响应但端口开着（单线程服务正忙）→ {"busy": True}；端口都不通 → None"""
+    try:
+        with urllib.request.urlopen(url + "/health", timeout=HEALTH_TIMEOUT_S) as r:
+            try:
+                return json.loads(r.read() or b"{}") or {"loaded": None}
+            except ValueError:
+                return {"loaded": None}
+    except (OSError, urllib.error.URLError):
+        import socket
+        hp = url.split("//", 1)[-1].split("/", 1)[0]
+        host, _, port = hp.partition(":")
+        try:
+            with socket.create_connection((host, int(port or 80)), timeout=2):
+                return {"busy": True}
+        except OSError:
+            return None
+
+
+def _per_job_s() -> float:
+    """本机看图实测单次耗时：route.jsonl 里最近 50 次本机成功的 seconds 中位数；没有记录 → PER_JOB_DEFAULT_S"""
+    try:
+        rows = ROUTE_LOG.read_text(encoding="utf-8").splitlines()[-400:]
+    except OSError:   # arch-ok: 还没有路由日志 = 用默认单次耗时
+        return PER_JOB_DEFAULT_S
+    xs = []
+    for ln in rows:
+        try:
+            r = json.loads(ln)
+        except ValueError:   # arch-ok: 坏行跳过
+            continue
+        if r.get("route") == "local" and r.get("ok") and r.get("seconds"):
+            xs.append(float(r["seconds"]))
+    xs = sorted(xs[-50:])
+    return xs[len(xs) // 2] if xs else PER_JOB_DEFAULT_S
+
+
+def client_timeout(wait_s: float, health: dict | None) -> float:
+    """单次超时：max(wait_s + 120, 本机实测单次耗时 × 2 × (排队数 + 1))，封顶 TIMEOUT_CAP_S"""
+    q = int((health or {}).get("queue") or 0)
+    return float(min(TIMEOUT_CAP_S, max(wait_s + 120, 2 * _per_job_s() * (q + 1))))
+
+
+def _route_log(rec: dict) -> None:
+    try:
+        ROUTE_LOG.parent.mkdir(parents=True, exist_ok=True)
+        with ROUTE_LOG.open("a", encoding="utf-8") as f:
+            f.write(json.dumps({"at": time.strftime("%F %T"), **rec}, ensure_ascii=False) + chr(10))
+    except OSError:   # arch-ok: 路由日志写不了不挡看图
+        pass
+
