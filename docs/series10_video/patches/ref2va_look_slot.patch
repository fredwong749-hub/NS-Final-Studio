+def look_slots(spec: ShotSpec, project: str) -> list[dict]:
+    try:
+        from ns_agent import asset_refs as AR
+    except ImportError:
+        return []
+    looks = AR.load_looks(project)
+    out = []
+    for c in spec.faces:
+        cid = getattr(c, "id", None) or ""
+        want = (c.look or "").strip().rstrip(".").lower()
+        lk = next((L for L in (looks.get(cid) or {}).values() if want and L.en.strip().rstrip(".").lower() == want), None)
+        sheet = AR.sheet_of(project, cid, lk.look_id) if lk else None
+        if sheet:
+            out.append({"role": "outfit", "character": c.name, "path": AR.sheet_crop(project, sheet, "front_nohead"),
+                        "sha": None, "look": lk.key, "sheet": sheet})
+    return out
+
