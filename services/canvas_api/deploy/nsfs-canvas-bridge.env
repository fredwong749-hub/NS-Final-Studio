# gpu3 渲染桥配置（/root/claude-kimi-ns-studio-v1/nsfs_canvas/nsfs-canvas-bridge.env）
# 默认项目（weita = 为他而骚）的读取目录，按优先级："标签|布局|路径"；takes = ns_render.pipeline 的 take 布局，weita = 微型测试（只读对照）
NSC_ROOTS=renders_gpu3|takes|/root/claude-kimi-ns-studio-v1/nsfs_mirror/data/renders_gpu3;weita|weita|/root/claude-kimi-ns-studio-v1/ns-studio/data/run/weita
# 队列文件所在目录：rerender_queue.jsonl / rerender_events.jsonl（唯一真源在 gpu3，所有项目共用，靠 project 字段区分）
NSC_QUEUE_DIR=/root/claude-kimi-ns-studio-v1/nsfs_mirror/data/renders_gpu3
NSC_CACHE_DIR=/root/claude-kimi-ns-studio-v1/nsfs_canvas/cache
# 封板修复 P0-4：只认 mirror 一份（笔记本 → mirror → 桥）
NSC_SCRIPT_JSON=/root/claude-kimi-ns-studio-v1/nsfs_mirror/data/import/script_v2.json
NSC_FFMPEG=/root/claude-kimi-ns-studio-v1/tools/ffmpeg/bin/ffmpeg
# 项目进度 / 系列控制 / GPU
NSC_RENDERS_BASE=/root/claude-kimi-ns-studio-v1/nsfs_mirror/data/renders_gpu3
NSC_DEFAULT_SLUG=weita
NSC_SERIES_OUT=/root/claude-kimi-ns-studio-v1/ns-studio/data/run/weita
NSC_BENCH_CSV=/root/claude-kimi-ns-studio-v1/nsfs_mirror/golden/bench.csv
NSC_MUSIC_DIR=/root/claude-kimi-ns-studio-v1/nsfs_mirror/data/music
NSC_LOCK_DIR=/root/.local/state/NS-Studio
# 封板修复：GPU1 永久给 Qwen 写作模型，不做渲染卡
NSC_COMFY=0=http://127.0.0.1:8188;3=http://127.0.0.1:8191
NSC_FAULTY_GPUS=2
# H3 lint 与审计规则表：取同步过去的仓库（nsfs_mirror）；规则表 nsfs_mirror 里没有时用桥 checkout 里随部署带过去的副本
NSC_H3_LINT=/root/claude-kimi-ns-studio-v1/nsfs_mirror/packages/schema/ns_schema/h3_lint.py
NSC_RULE_IDS=/root/claude-kimi-ns-studio-v1/nsfs_mirror/docs/audit/rule_ids.md;/root/claude-kimi-ns-studio-v1/nsfs_canvas/app/docs/audit/rule_ids.md
# 规则说明：shot_audit.py --explain <id> --json（cwd = ns-studio）
NSC_SHOT_AUDIT=/root/claude-kimi-ns-studio-v1/ns-studio/scripts/shot_audit.py
NSC_SHOT_AUDIT_PYTHON=/root/claude-kimi-ns-studio-v1/ns-studio/.venv/bin/python
NSC_EXPLAIN_TIMEOUT=15
# 封板修复：按集运行只能选 GPU0/GPU3（GPU1 = Qwen，GPU2 坏卡）
NSC_RUN_GPUS=0,3
# 封板修复：人物状态时间线读 mirror（原默认路径不存在，needs_review 永远看不到）
NSC_STATE_TIMELINE=/root/claude-kimi-ns-studio-v1/nsfs_mirror/data/state_timeline.json
